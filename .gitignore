# ==========================================================================
#  02-GasDetector - Git 忽略规则
# --------------------------------------------------------------------------
#  原则：只跟踪"源码 + 文档"。
#        编译产物、IDE 状态、第三方未使用的资源都不入库。
# ==========================================================================

# ---------------------------------------------------------------- 编译产物 --
# build/ 由 build.bat 生成，任何人 clone 后执行 build.bat 即可重建
build/
*.o
*.d
*.crf
*.dep
*.lnp

# Keil 编译中间文件与产物
*.axf
*.hex
*.bin
*.elf
*.map
*.htm
*.lst
*.build_log.htm
*.scvd
*.__i
*._ia
*.iex
*.sct.bak
JLinkLog.txt
JLinkSettings.ini
EventRecorderStub.scvd

# 编译器临时目录（build.bat 会把 TMP/TEMP 钉到这里）
.tmp/

# ------------------------------------------------------------ IDE / 编辑器 --
# 注意：.vscode/ 故意保留并入库，它包含任务、烧录和调试配置
# （见 .vscode/tasks.json、launch.json），对使用者有价值。
.idea/
*.uvguix.*
*.uvoptx
*.uvprojx.bak
*.swp
*~

# ------------------------------------------------------------ 第三方未使用 --
# LVGL 官方 demos（56MB，含音乐/图片素材）—— Makefile 未引用，不参与编译。
# 需要跑官方 demo 时，单独从 LVGL 仓库下载 examples/demos 即可。
LVGL/GUI_APP/

# ------------------------------------------------------------------ 系统 --
Thumbs.db
desktop.ini
.DS_Store
